# Copy to .env and fill in. Every setting is read in backend/config/settings.py.

# Required unless DEBUG=1. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 1 only for local development.
DEBUG=0

# The app's public address, as MCP clients reach it. No trailing slash.
# https only (claude.ai won't connect otherwise): your proxy or tunnel ends HTTPS
# and sends X-Forwarded-Proto: https. The app answers this host name only.
BASE_URL=https://311.example.com

# Other host names to answer to, comma-separated. Usually empty.
ALLOWED_HOSTS=

# Where the SQLite database lives, and where `manage.py backup` writes.
# The image's defaults; change them only to mount the folders elsewhere.
DATA_DIR=/data
BACKUP_DIR=/data/backups

# Behind a proxy or tunnel: the header that carries the visitor's real IP, used
# for the login lockout. Without it, every visitor looks like the proxy, and
# five wrong passwords from anyone would lock out everyone.
#   Cloudflare Tunnel: CF-Connecting-IP    Caddy or nginx: X-Forwarded-For
# Only set it if the app can't be reached except through that proxy: anyone
# reaching the app directly could fake the header.
CLIENT_IP_HEADER=

# Cloudflare Tunnel only (deploy/cloudflare/compose.yaml): the tunnel's token
# from the Cloudflare dashboard. Read by cloudflared, not by the app.
TUNNEL_TOKEN=
